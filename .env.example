# Preferred external env file for production:
# /home/user/codex-telegram.env

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_CHAT_IDS=
BRIDGE_HOME=/var/lib/codex-telegram
LOGS_ROOT=/var/log/codex-telegram
STATE_DB_PATH=/var/lib/codex-telegram/state.db
BRIDGE_SCAN_ROOTS=/srv/projects,/home/user
PROJECTS_ROOT=/srv/projects
DEFAULT_PROJECT_ROOT=/srv/projects
DEFAULT_PROJECT_HINT=
DOWNLOADS_PATH=/mnt/c/Users/YOUR_WINDOWS_USER/Downloads
CODEX_BIN=/usr/bin/codex
CODEX_MODEL=
CODEX_RUN_AS_ROOT=true
CODEX_SANDBOX=danger-full-access
CODEX_APPROVAL_POLICY=never
JOB_TIMEOUT_SECONDS=5400
WORKER_POLL_INTERVAL_SECONDS=3
LONG_TASK_PROGRESS_SECONDS=45
IMAGE_COLLECT_WINDOW_SECONDS=4
LOG_LEVEL=INFO
TELEGRAM_STATUS_NOTIFICATIONS=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
